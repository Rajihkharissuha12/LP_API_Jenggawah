// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IdentityType {
  KTP
  SIM
  PEL
  OTHER
}

enum PricingType {
  PER_TICKET
  PER_HOUR
  PER_DAY
}

enum BookingStatus {
  NEW          // baru masuk dari landing page
  APPROVED     // telah diverifikasi admin (kontak WA)
  CONFIRMED    // slot dikunci, siap datang
  CANCELLED    // dibatalkan admin/pelanggan
  COMPLETED    // sudah terlaksana
}

enum PaymentStatus {
  PENDING
  DP
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER_MANUAL
  QRIS_OFFLINE
}

enum SalesPaymentMethod {
  CASH
  TRANSFER
  QRIS
}

enum TransactionType {
  DP
  PAID
  REFUND
  ADJUSTMENT
}

enum VerificationMethod {
  NONE
  WHATSAPP
  PHONE
  OTHER
}

enum AvailabilityType {
  OPEN     // slot dibuka spesifik (opsional jika pakai rule)
  BLOCK    // blokir/blackout (maintenance/event)
}

enum FacilityCategory {
  OUTDOOR
  INDOOR
  WATER
  SPORT
  EVENT
  OTHER
}

enum BahanType {
  PCS
  GRAM
  KG
  ML
  LITER
  PACK
  BOTOL
}

enum BahanTypePembelian {
  PCS
  DUS
  PACK
  KARUNG
  BOTOL
}

enum StockOpnameStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum SalesStatus {
  PENDING_PAYMENT   // menunggu pembayaran
  PAID              // sudah bayar
  PREPARING         // sedang dibuat
  READY             // siap diambil
  COMPLETED         // transaksi selesai
  CANCELLED
  REFUNDED
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum PaymentStatuss {
  UNPAID
  PARTIAL
  PAID
}

enum JenisMutasi {
  MASUK
  KELUAR
  ADJUSTMENT
}


enum StatusCashSession {
  OPEN
  CLOSE
}

enum StatusAbsensi {
  VALID
  DILUAR_RADIUS
}

enum TipeAbsensi {
  MASUK
  PULANG
}

// ===== Core Actors =====
model Admin {
  id        String        @id @default(uuid())
  username  String        @unique
  password  String
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  isDeleted Boolean       @default(false)

  logs      AuditLog[]
  stockOpname  StockOpname[]
  cashSessions CashSession[]
  contactLogs  ContactLog[]
  adminRoles   AdminRole[]
  penjualans Penjualan[]
  absens Absensi[]
}

model Role{
  id String @id @default(uuid())
  role String
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  isDeleted Boolean       @default(false)

  adminRoles   AdminRole[]
}

model AdminRole {
  adminId      String
  roleId       String
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)

  admin        Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role         Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
}

model Customer {
  id             String    @id @default(uuid())
  fullName       String
  nik String @unique
  phone          String
  email          String?
  address        String?
  identityType   IdentityType?
  identityNumber String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  isDeleted      Boolean   @default(false)

  bookings       Booking[]
  contacts       ContactLog[]
}

// ===== Facilities & Calendar =====
model Facility {
  id              String       @id @default(uuid())
  name            String
  description     String?
  pricingType     PricingType
  minDuration     Int?
  basePrice       Decimal      @db.Decimal(12, 2)
  // Tambahan untuk FE cards
  heroImage       Json?                         // URL utama untuk hero [attached_file:1]
  images          Json?    // daftar URL gambar (gallery) [attached_file:1]
  category        FacilityCategory?               // kategori untuk filter FE [attached_file:1]
  rating          Decimal?        @db.Decimal(3,2) // misal 4.8 [attached_file:1]
  ratingCount     Int?                            // jumlah ulasan [attached_file:1]
  features        String[]        @default([])    // fitur-fitur ringkas [attached_file:1]
  capacityLabel   String?                         // contoh: "2-6 orang" [attached_file:1]
  durationLabel   String?                         // contoh: "Per malam" (opsional) [attached_file:1]
  iconKey         String?                         // contoh: "tent" untuk di-map di FE [attached_file:1]
  rules           String?     @db.Text
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  isDeleted       Boolean      @default(false)
  bookings        Booking[]
  availability    AvailabilityType
  closures        FacilityClosure[]
  priceLists      PriceList[]
  priceAdjustments PriceAdjustment[]
  bookingRules    BookingRule?
}

model FacilityClosure {
  id         String   @id @default(uuid())
  facilityId String
  startAt    DateTime @db.Timestamptz(3)
  endAt      DateTime @db.Timestamptz(3)
  reason     String?

  facility   Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, startAt, endAt])
}

model BookingRule {
  id                  String   @id @default(uuid())
  facilityId          String   @unique
  bookingWindowDays   Int?     // maksimun hari ke depan bisa pesan
  advanceNoticeHours  Int?     // minimal H-x jam sebelum mulai
  prepBufferBeforeMin Int?     // buffer persiapan sebelum
  prepBufferAfterMin  Int?     // buffer sesudah
  maxParticipants     Int?

  facility   Facility  @relation(fields: [facilityId], references: [id])
}

// ===== Booking & Items =====
model Booking {
  id              String         @id @default(uuid())
  bookingCode     String         @unique
  customerId      String
  facilityId      String

  // tanggal/waktu utama (opsional jika pakai BookingItem multi-sesi)
  bookingDate     DateTime
  startTime       DateTime?
  endTime         DateTime?

  participants    Int
  purpose         String?

  status          BookingStatus
  adminNote       String?

  // verifikasi via WA/Phone
  verificationMethod VerificationMethod @default(NONE)
  verifiedAt      DateTime?
  source          String? // WEB/ADMIN

  // pricing snapshot
  totalAmount     Decimal        @db.Decimal(12, 2)
  currency        String         @default("IDR")

  version         Int            @default(1) // optimistic locking
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  isDeleted       Boolean        @default(false)

  customer Customer @relation(fields: [customerId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  items     BookingItem[]
  payments  Payment?
  contacts  ContactLog[]
  auditLogs AuditLog[]
   transactions PaymentTransaction[]

  @@index([facilityId, bookingDate])
  @@index([status])
}

model BookingItem {
  id         String   @id @default(uuid())
  bookingId  String
  date       DateTime @db.Date
  startTime  DateTime?
  endTime    DateTime?
  unitType   PricingType // PER_HOUR/PER_DAY, sinkron dengan pricing
  unitCount  Int?
  price      Decimal  @db.Decimal(12, 2)
  meta       Json?     // snapshot nama fasilitas, tarif, dsb.
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  isDeleted       Boolean        @default(false)

  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId, date])
}

// ===== Payments (offline) =====
model Payment {
  id              String          @id @default(uuid())
  bookingId       String          @unique
  status          PaymentStatus
  totalDue        Decimal         @db.Decimal(12, 2)
  totalPaid       Decimal         @db.Decimal(12, 2) @default(0)
  lastTransactionAt DateTime?
  notes String?

  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  isDeleted       Boolean         @default(false)

  booking         Booking         @relation(fields: [bookingId], references: [id])
  transactions    PaymentTransaction[]
}

model PaymentTransaction {
  id            String           @id @default(uuid())
  bookingId     String
  amount        Decimal          @db.Decimal(12, 2)
  type          TransactionType
  method        PaymentMethod
  status        String           @default("RECORDED") // atau enum kecil jika perlu
  receiptNumber String?
  cashierId     String?
  paidAt        DateTime?
  locationId    String?
  proofUrl      String?
  notes         String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  isVoided      Boolean          @default(false)
  voidReason    String?
  voidedBy      String?
  voidedAt      DateTime?
  paymentId     String
  payment       Payment         @relation(fields: [paymentId], references: [id])
  booking       Booking          @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
}

// Opsional: sesi kasir/loket per admin untuk rekap harian
model CashSession {
  id         String   @id @default(uuid())
  adminId    String
  locationId String?
  openedAt   DateTime @default(now()) @db.Timestamptz(3)
  closedAt   DateTime? @db.Timestamptz(3)
  status     StatusCashSession @default(OPEN)
  openingCash Decimal         @db.Decimal(12, 2) @default(0)
   /**
   * Hasil perhitungan sistem
   */
  expectedCash Decimal? @db.Decimal(14, 2)
  /**
   * Uang fisik yang dihitung kasir
   */
  actualCash Decimal? @db.Decimal(14, 2)
  /**
   * Selisih:
   * actualCash - expectedCash
   */
  difference Decimal? @db.Decimal(14, 2)
  /**
   * Ringkasan shift
   */
  totalCashSales Decimal? @db.Decimal(14, 2) @default(0)

  totalNonCashSales Decimal? @db.Decimal(14, 2) @default(0)

  totalCashIn Decimal? @db.Decimal(14, 2) @default(0)

  totalCashOut Decimal? @db.Decimal(14, 2) @default(0)
  /**
   * Catatan closing
   */
  closingNote String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  isdeleted Boolean @default(false)

  penjualans Penjualan[]

  admin      Admin    @relation(fields: [adminId], references: [id])
}

// ===== Pricing =====
model PriceList {
  id          String     @id @default(uuid())
  facilityId  String
  pricingType PricingType
  unitPrice   Decimal    @db.Decimal(12, 2)
  minDuration Int?
  maxDuration Int?
  effectiveFrom DateTime
  effectiveTo   DateTime?

  facility    Facility   @relation(fields: [facilityId], references: [id])

  @@index([facilityId, effectiveFrom])
}

model PriceAdjustment {
  id          String   @id @default(uuid())
  facilityId  String
  kind        String   // PEAK/OFF_PEAK/DISCOUNT/PROMO
  rule        Json     // mis. hari, jam, tanggal khusus
  valueType   String   // PERCENT/FIXED
  amount      Decimal  @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  facility    Facility @relation(fields: [facilityId], references: [id])
}

model Bahan {
  id             String                @id @default(uuid())
  nama           String
  kategori       String
  satuan         BahanType
  minimum_stok   Int
  stok           Int                   @default(0)
  hargaPerSatuan Decimal @default(0)

  pembelian      PembelianBahan[]
  mutasi         StokMutasi[]
  stockOpnameDetails StockOpnameDetail[]
  menuRecipes    MenuRecipe[]
  penjualanRecipes PenjualanDetailRecipe[]


  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  isDeleted      Boolean               @default(false)
}

model PembelianBahan {
  id                String                @id @default(uuid())

  // Relasi
  bahanId           String
  bahan             Bahan                 @relation(fields: [bahanId], references: [id], onDelete: Restrict)

  supplierId        String
  supplier          Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  // Data Pembelian
  tanggal           DateTime
  qtyBeli           Int
  satuanBeli        BahanTypePembelian
  isiPerSatuan      Int

  hargaSatuan       Decimal               @db.Decimal(12,2)
  hargaTotal        Decimal               @db.Decimal(12,2)
  hargaPerUnit      Decimal               @db.Decimal(12,2) @default(0)

  // Upload Struk
  imgStrukUrl       String?
  imgStrukPath      String?

  // Upload Barang
  imgBarangUrl      String?
  imgBarangPath     String?

  optional      Json?
  totalOptional Int?  @default(0)

  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  isDeleted         Boolean               @default(false)
}

model Supplier {
  id          String             @id @default(uuid())
  nama        String
  pic         String?
  no_hp       String?
  email       String?
  alamat      String?
  keterangan  String?

  pembelian   PembelianBahan[]

  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  isDeleted Boolean @default(false)
}

model StokMutasi {
  id              String                @id @default(uuid())

  bahanId         String
  bahan           Bahan                 @relation(fields: [bahanId], references: [id], onDelete: Restrict)

  jenis           JenisMutasi
  qty             Int
  stokSetelah     Int
  keterangan      String?
  penjualanId String?
  penjualan Penjualan? @relation(fields: [penjualanId], references: [id], onDelete: SetNull)

  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  isDeleted       Boolean               @default(false)
}



// ===== Contacts (WhatsApp log ringkas) =====
model ContactLog {
  id             String   @id @default(uuid())
  // jika log ini terkait booking tertentu, boleh tetap ada:
  bookingId      String?
  booking        Booking? @relation(fields: [bookingId], references: [id])

  // WAJIB untuk opposite relation ke Customer:
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])

  adminId        String?
  admin          Admin?   @relation(fields: [adminId], references: [id])

  channel        String   @default("WHATSAPP")
  direction      String   @default("OUT")
  messageSummary String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@index([bookingId, createdAt])
}

// ===== Audit log immutable =====
model AuditLog {
  id         String   @id @default(uuid())
  actorType  String   // ADMIN/SYSTEM/CUSTOMER
  actorId    String?
  action     String   // BOOKING_CREATE/STATUS_CHANGE/PAYMENT_ADD/...
  entity     String   // booking/payment/transaction/...
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  // Relasi opsional ke booking agar mudah difilter
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])

  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([bookingId, createdAt])
  @@index([adminId, createdAt])
}

model StockOpname {
  id             String               @id @default(uuid())
  nomor          String               @unique
  tanggal        DateTime
  status         StockOpnameStatus    @default(DRAFT)
  totalBarang    Int                  @default(0)
  totalSelisih   Int                  @default(0)
  keterangan     String?
  createdBy      String
  admin          Admin                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  details        StockOpnameDetail[]

  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  isDeleted      Boolean              @default(false)

  @@index([tanggal])
  @@index([status])
}

model StockOpnameDetail {
  id              String          @id @default(uuid())

  stockOpnameId   String
  stockOpname     StockOpname     @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)

  bahanId         String
  bahan           Bahan           @relation(fields: [bahanId], references: [id], onDelete: Restrict)

  stokSistem      Int
  stokFisik       Int

  selisih         Int

  catatan         String?

  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@index([stockOpnameId])
  @@index([bahanId])
}

model MenuCategory{

 id String @id @default(uuid())

 nama String
 deskripsi String?
 isActive Boolean @default(true)

 createdAt DateTime @default(now()) @db.Timestamptz(3)

 updatedAt DateTime @updatedAt @db.Timestamptz(3)

 isDeleted Boolean @default(false)

 menus      Menu[]

}

model Menu {
  id          String   @id @default(uuid())

  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])

  nama        String
  deskripsi   String?
  foto        String?

  hargaJual   Int  
  hpp         Int @default(0)

  marginNominal Int @default(0) 

  marginPersen Int @default(0)

  isActive    Boolean  @default(true)

  recipes     MenuRecipe[]
  penjualanDetails PenjualanDetail[]


  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  isDeleted   Boolean  @default(false)
}

model MenuRecipe{

 id String @id @default(uuid())

 qty Decimal

  menuId   String
  menu     Menu @relation(fields: [menuId], references: [id])

  bahanId  String
  bahan    Bahan @relation(fields: [bahanId], references: [id])

}

model Penjualan {

  id String @id @default(uuid())

  nomorInvoice String @unique

  clientRefId String? @unique

  lastAdjustmentRefId String?

  queueNumber String?

  adminId String
  admin Admin @relation(fields: [adminId], references: [id])

  cashSessionId String?

  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])

  customerName String?

  orderType OrderType

  tableNumber String?

  subtotal Int

  discountAmount Int? @default(0)

  discountPercent Int? @default(0)

  isTaxEnabled Boolean @default(false)

  taxPercent Int @default(0)

  taxRate Int @default(0)

  taxAmount Int @default(0)

  grandTotal Int

  status SalesStatus @default(PENDING_PAYMENT)

  notes String?

  paidAt DateTime?

  totalItem Int

  paymentStatus PaymentStatuss @default(UNPAID)

  printedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  details PenjualanDetail[]

  payments PenjualanPayment[]

  stockMutations StokMutasi[]

  @@index([createdAt])

  @@index([status])

  @@index([paymentStatus])

  @@index([adminId])

  @@index([cashSessionId])
}

model PenjualanPayment {

  id           String @id @default(uuid())

  penjualanId  String
  penjualan    Penjualan @relation(fields: [penjualanId], references: [id], onDelete: Cascade)

  method       SalesPaymentMethod

  amount       Int
  paidAmount   Int
  changeAmount Int

  proofImagePath String?
  proofImageUrl  String?

  referenceNo String?

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([penjualanId])
}

model PenjualanDetail {

  id              String      @id @default(uuid())

  penjualanId     String
  penjualan       Penjualan   @relation(fields: [penjualanId], references: [id], onDelete: Cascade)

  menuId          String
  menu            Menu        @relation(fields: [menuId], references: [id])

  namaMenu        String

  catatan         String?

  hargaJual       Int

  hpp             Int

  qty             Int

  subtotal        Int

  fotoMenu String?

  categoryName String?

  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  recipes         PenjualanDetailRecipe[]

  @@index([penjualanId])
}

model PenjualanDetailRecipe {

  id                  String              @id @default(uuid())

  penjualanDetailId   String
  penjualanDetail     PenjualanDetail    @relation(fields: [penjualanDetailId], references: [id], onDelete: Cascade)

  bahanId             String
  bahan               Bahan              @relation(fields: [bahanId], references: [id])

  namaBahan           String

  qty                 Decimal            @db.Decimal(10,2)

  hargaPerUnit        Decimal            @db.Decimal(12,2)

  totalHpp            Decimal            @db.Decimal(12,2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  isDeleted   Boolean  @default(false)
}

model Config {
  id                  String              @id @default(uuid())
  name                 String             
  value               Boolean
}

model WorkLocation {
  id        Int       @id @default(autoincrement())
  nama      String
  latitude  Float
  longitude Float
  radius    Int       @default(100) // meter, batas absen valid
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  absensi   Absensi[]
}

model Absensi {
  id             Int           @id @default(autoincrement())
  adminId        String
  admin          Admin         @relation(fields: [adminId], references: [id])
  workLocationId Int?
  workLocation   WorkLocation? @relation(fields: [workLocationId], references: [id])

  tipe     TipeAbsensi
  tanggal  DateTime      @db.Date   // server WIB, guard harian
  waktu    DateTime      @default(now())

  latitude  Float        // audit — jangan dipercaya penuh
  longitude Float
  jarak     Int          // Haversine, DIHITUNG SERVER
  status    StatusAbsensi

  fotoUrl  String
  fotoPath String

  createdAt DateTime     @default(now())

  @@unique([adminId, tipe, tanggal]) // 1 masuk + 1 pulang / hari
}